<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Location. COARSE + FINE are requested together because Android 12+
         lets the user grant only the approximate one; the app still works,
         just with a wider accuracy halo on the dispatcher's map. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Reporting continues with the screen off, which is the whole point on
         a phone sitting in a truck cab. Android requires a visible, permanent
         notification while this runs — the driver always sees that the app is
         sharing location, and it stops when they clock out. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- The notification the foreground service posts (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets the app ASK to be exempt from Doze battery optimisation. Without
         the exemption Android throttles the location service once the screen
         is off and the phone is still — which is what a truck parked at a long
         stop looks like. The driver still has to accept the system dialog. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- GPS hardware isn't strictly required: a phone without it still runs
         the app, it just can't contribute to the live map. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- D-638 (2026-10-22): the camera. The driver takes several delivery photos in a row from inside the app
         (getUserMedia: Capacitor's onPermissionRequest asks for CAMERA at runtime, and without this line Android denies
         it outright). The native one-photo camera (<input capture>) also asks for it now, once. A phone without a
         camera still installs the app. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
