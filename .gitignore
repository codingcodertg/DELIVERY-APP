/node_modules
/.next
/out
/build
next-env.d.ts
*.tsbuildinfo
.env.local
.DS_Store
.vercel
*.log
*.lnk

.vercel
.env*

# Agent tooling / skills (installed locally by marketplace integrations)
.agents/
.claude/*

# EXCEPCION: los subagentes definidos en el repo SI se versionan. El auditor del
# flujo de ramas (docs/WORKFLOW-PARALELO.md) es parte del proceso, no config
# local de una maquina: si no viaja con el codigo, cada sesion audita distinto.
# Todo lo demas de .claude/ sigue ignorado — incluidos settings.local.json (que
# es por maquina) y .claude/worktrees/ (donde Claude Code crea los worktrees).
!.claude/agents/

# Firebase SERVICE ACCOUNT keys — these can send notifications as you.
# (google-services.json is NOT here on purpose: it ships inside every APK.)
*firebase-adminsdk*.json
service-account*.json

# Scratch files from API/database work. _k.json once held revealed Supabase API
# keys and was caught by GitHub push protection on the way out — ignored here so
# a stray one can never be staged again.
_*.json
q*.json
_*.json

# La app de escritorio del hub (D-166). `/node_modules` de arriba lleva barra, o sea que
# solo tapa el de la raiz; y `dist/` es el instalador compilado, que pesa ~90 MB y se
# vuelve a generar con un comando.
desktop/node_modules
desktop/dist
