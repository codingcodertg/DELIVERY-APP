# Copy this file to .env.local and fill with your Supabase project values.
# Find them in Supabase Dashboard → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Needed for the Users tab (inviting / deleting users).
# Never expose this in NEXT_PUBLIC_*. Add it in Vercel → Project → Settings → Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ---- Google Maps ------------------------------------------------------------
# SERVER key: pays for Routes (optimisation, traffic, distances) and Geocoding.
# Never exposed to the browser. Restrict it by API in the Cloud console.
GOOGLE_MAPS_API_KEY=

# BROWSER key: draws the map itself (Maps JavaScript API). This one IS visible
# to anyone who opens devtools, which is unavoidable — so it must be a SEPARATE
# key, restricted by HTTP referrer to your domains and limited to the Maps
# JavaScript API. Never reuse the server key here: a stolen unrestricted key
# can run up Routes billing.
# Leave blank and the app keeps using the free OpenStreetMap map.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Optional Cloud-styled Map ID (Console → Map Management). Only needed for
# custom map styling; the map works without it.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# «Entrar como» (D-NEXT): un admin entra en la sesión REAL de otro usuario, sin contraseña.
# APAGADO por defecto y a propósito — con la variable ausente la ruta responde 404 y el botón
# no existe. Antes de encenderlo hay que comprobar una cosa contra un buzón propio: que generar
# el enlace mágico no dispare además el correo del proyecto. Ponerlo a "true" es lo que lo
# activa; quitarlo lo apaga sin desplegar, que es la propiedad que importa si algo sale mal.
IMPERSONATION_ENABLED=false
